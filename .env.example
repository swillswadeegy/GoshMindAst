# OpenAI
# Your OpenAI API key — required
OPENAI_API_KEY=sk-...

# Vector store ID containing the GOSH policy documents
# Default: vs_6837a69465748191a9a3deef54538a25
OPENAI_FILE_ID=vs_6837a69465748191a9a3deef54538a25

# Optional: override the system prompt at runtime.
# If not set, the built-in GOSH policy prompt is used.
# OPENAI_SYSTEM_PROMPT=

# Removed — no longer needed after migration to Responses API
# OPENAI_ASSISTANT_ID=

# Database (if using PostgreSQL via Drizzle)
DATABASE_URL=postgresql://user:password@host:5432/dbname
